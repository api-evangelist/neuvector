            "url": "{{baseUrl}}/v1/system/config"
          },
          "docs": "System configure"
        },
        {
          "info": {
            "name": "Get system configuration (starting from 5.0, rest client should call this api.)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v2/system/config",
            "params": [
              {
                "name": "scope",
                "value": "",
                "type": "query",
                "description": "When set the scope to be fed, it will return the fed system configures. When set the scope to be local, it will return the local system configures. If there is no query string 'scope', it will return all system configures."
              }
            ]
          },
          "docs": "Get system configuration (starting from 5.0, rest client should call this api.)"
        },
        {
          "info": {
            "name": "System configure (starting from 5.0, rest client should call this api.)",
