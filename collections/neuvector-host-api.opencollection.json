          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/host"
          },
          "docs": "Get a list of hosts"
        },
        {
          "info": {
            "name": "Show host",
            "type": "http"
          },
          "http": {
            "method": "GET",
