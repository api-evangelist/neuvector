            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Host ID"
              }
            ]
          },
          "docs": "Show host"
        },
        {
          "info": {
            "name": "Show host compliance report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/host/:id/compliance",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Host ID"
              }
            ]
          },
          "docs": "Show host compliance report"
        }
      ]
    }
  ],
  "bundled": true
