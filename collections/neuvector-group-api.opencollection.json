{
  "opencollection": "1.0.0",
  "info": {
    "name": "NeuVector Group API",
    "version": "5.6.0"
  },
  "items": [
    {
      "info": {
        "name": "Group",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/group",
            "params": [
              {
                "name": "scope",
                "value": "",
                "type": "query",
                "description": "When set to fed, returned fed groups. When set to local, returned local groups. If there is no query string 'scope', all groups will be returned."
              }
            ]
          },
          "docs": "Get a list of groups"
        },
        {
          "info": {
            "name": "Create group",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/group"
          },
          "docs": "Create group"
        },
        {
          "info": {
            "name": "Show group",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/group/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Group name"
              }
            ]
          },
          "docs": "Show group"
        },
        {
          "info": {
            "name": "Update group",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/v1/group/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Group name"
              }
            ]
          },
          "docs": "Update group"
        },
        {
          "info": {
            "name": "Delete group",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1/group/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Group name"
              }
            ]
          },
          "docs": "Delete group"
        }
      ]
    }
  ],
  "bundled": true
}