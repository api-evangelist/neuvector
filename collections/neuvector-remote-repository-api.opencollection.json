{
  "opencollection": "1.0.0",
  "info": {
    "name": "NeuVector Remote Repository API",
    "version": "5.6.0"
  },
  "items": [
    {
      "info": {
        "name": "Remote Repository",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a remote repository.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/system/config/remote_repository"
          },
          "docs": "Create a remote repository."
        },
        {
          "info": {
            "name": "Update a remote repository.",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/v1/system/config/remote_repository/:alias",
            "params": [
              {
                "name": "alias",
                "value": "",
                "type": "path",
                "description": "The alias of the remote repository to update."
              }
            ]
          },
          "docs": "Update a remote repository."
        }
      ]
    }
  ],
  "bundled": true
}