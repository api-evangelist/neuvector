{
  "opencollection": "1.0.0",
  "info": {
    "name": "NeuVector Sniffer API",
    "version": "5.6.0"
  },
  "items": [
    {
      "info": {
        "name": "Sniffer",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of sniffers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/sniffer",
            "params": [
              {
                "name": "f_workload",
                "value": "",
                "type": "query",
                "description": "Workload ID"
              }
            ]
          },
          "docs": "Get a list of sniffers"
        },
        {
          "info": {
            "name": "Sniffer start",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/sniffer",
            "params": [
              {
                "name": "f_workload",
                "value": "",
                "type": "query",
                "description": "Workload ID"
              }
            ]
          },
          "docs": "Sniffer start"
        },
        {
          "info": {
            "name": "Show sniffer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/sniffer/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Sniffer ID"
              }
            ]
          },
          "docs": "Show sniffer"
        },
        {
          "info": {
            "name": "Delete sniffer",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1/sniffer/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Sniffer ID"
              }
            ]
          },
          "docs": "Delete sniffer"
        },
        {
          "info": {
            "name": "Stop sniffer",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/v1/sniffer/stop/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Sniffer ID"
              }
            ]
          },
          "docs": "Stop sniffer"
        },
        {
          "info": {
            "name": "Sniffer get a pcap file",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/sniffer/:id/pcap",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Sniffer ID"
              }
            ]
          },
          "docs": "Sniffer get a pcap file"
        }
      ]
    }
  ],
  "bundled": true
}